<?php

declare(strict_types=1);

use Fisharebest\Webtrees\I18N;
use WebtreesShare\GedcomSnapshot;

/**
 * @var string                $title
 * @var string                $token
 * @var string                $name
 * @var array<string,string>  $fields
 * @var list<array{tag: string, label: string, value: string}> $context
 * @var string                $app_url
 * @var string                $action
 * @var string                $tree_title
 * @var string                $tree_url
 * @var string                $requester_name
 * @var string                $photo_url
 */

$birt_date_iso = GedcomSnapshot::gedcomDateToIso($fields['BIRT_DATE'] ?? '');
$deat_date_iso = GedcomSnapshot::gedcomDateToIso($fields['DEAT_DATE'] ?? '');

?>

<a class="wtshare-brand" href="<?= e($tree_url) ?>">
  <img class="wtshare-logo" src="/modules_v4/webtrees-contribution-request/resources/img/logo.png" alt="">
  <span><?= e($tree_title) ?></span>
</a>

<h1 class="wtshare-title"><?= e($title) ?></h1>
<?php if ($requester_name !== '') : ?>
  <p class="wtshare-requester"><?= I18N::translate('Angefragt von %s', e($requester_name)) ?></p>
<?php endif; ?>
<?php // $name is already-formatted HTML from webtrees' own fullName() (e.g. <span class="NAME">...) - escaping it here just shows the raw tags. ?>
<p class="wtshare-subtitle"><?= I18N::translate('Für: %s', $name) ?></p>

<form method="post" action="<?= e($action) ?>" enctype="multipart/form-data">
  <?= csrf_field() ?>
  <input type="hidden" name="token" value="<?= e($token) ?>">

  <div class="wtshare-card" style="text-align: center;">
    <div class="wtshare-photo-wrap">
      <img
        id="wtshare-photo-preview"
        class="wtshare-photo"
        src="<?= e($photo_url) ?>"
        alt=""
        style="<?= $photo_url === '' ? 'display:none' : '' ?>"
      >
      <div
        id="wtshare-photo-placeholder"
        class="wtshare-photo wtshare-photo-placeholder"
        style="<?= $photo_url !== '' ? 'display:none' : '' ?>"
      >
        <svg viewBox="0 0 24 24" width="64" height="64" fill="var(--text-tertiary)" aria-hidden="true">
          <path d="M12 12c2.7 0 4.9-2.2 4.9-4.9S14.7 2.2 12 2.2 7.1 4.4 7.1 7.1 9.3 12 12 12zm0 2.4c-3.3 0-9.8 1.6-9.8 4.9v2.5h19.6v-2.5c0-3.3-6.5-4.9-9.8-4.9z"/>
        </svg>
      </div>
      <label for="wtshare-photo" class="wtshare-photo-upload" title="<?= e(I18N::translate('Foto hinzufügen')) ?>">+</label>
      <input type="file" id="wtshare-photo" name="photo" accept="image/*" class="wtshare-photo-input">
    </div>
  </div>
  <script>
    // Selecting a file (incl. taking a photo on mobile) doesn't reload the page, so without
    // this the guest sees no feedback at all that anything was chosen - looked like the upload
    // silently did nothing, even though the file was actually attached correctly.
    document.getElementById('wtshare-photo').addEventListener('change', function (event) {
      var file = event.target.files && event.target.files[0];
      if (!file) {
        return;
      }
      var preview = document.getElementById('wtshare-photo-preview');
      var placeholder = document.getElementById('wtshare-photo-placeholder');
      preview.src = URL.createObjectURL(file);
      preview.style.display = 'block';
      placeholder.style.display = 'none';
    });
  </script>

  <div class="wtshare-card">
    <div class="wtshare-field">
      <label for="wtshare-givn"><?= I18N::translate('Vorname') ?></label>
      <input type="text" id="wtshare-givn" name="GIVN" value="<?= e($fields['GIVN'] ?? '') ?>">
    </div>
    <div class="wtshare-field">
      <label for="wtshare-surn"><?= I18N::translate('Nachname') ?></label>
      <input type="text" id="wtshare-surn" name="SURN" value="<?= e($fields['SURN'] ?? '') ?>">
    </div>
    <div class="wtshare-field">
      <label for="wtshare-titl"><?= I18N::translate('Titel') ?></label>
      <input type="text" id="wtshare-titl" name="TITL" value="<?= e($fields['TITL'] ?? '') ?>">
    </div>
    <div class="wtshare-field">
      <label for="wtshare-birt-date"><?= I18N::translate('Geburtsdatum') ?></label>
      <input type="date" id="wtshare-birt-date" name="BIRT_DATE" value="<?= e($birt_date_iso) ?>">
      <?php if ($birt_date_iso === '' && ($fields['BIRT_DATE'] ?? '') !== '') : ?>
        <p class="wtshare-hint"><?= I18N::translate('Bisheriger Wert: %s', e($fields['BIRT_DATE'])) ?></p>
      <?php endif; ?>
    </div>
    <div class="wtshare-field">
      <label for="wtshare-birt-plac"><?= I18N::translate('Geburtsort') ?></label>
      <input type="text" id="wtshare-birt-plac" name="BIRT_PLAC" value="<?= e($fields['BIRT_PLAC'] ?? '') ?>">
    </div>
    <div class="wtshare-field">
      <label for="wtshare-deat-date"><?= I18N::translate('Sterbedatum') ?></label>
      <input type="date" id="wtshare-deat-date" name="DEAT_DATE" value="<?= e($deat_date_iso) ?>">
      <?php if ($deat_date_iso === '' && ($fields['DEAT_DATE'] ?? '') !== '') : ?>
        <p class="wtshare-hint"><?= I18N::translate('Bisheriger Wert: %s', e($fields['DEAT_DATE'])) ?></p>
      <?php endif; ?>
    </div>
    <div class="wtshare-field">
      <label for="wtshare-deat-plac"><?= I18N::translate('Sterbeort') ?></label>
      <input type="text" id="wtshare-deat-plac" name="DEAT_PLAC" value="<?= e($fields['DEAT_PLAC'] ?? '') ?>">
    </div>
    <div class="wtshare-field">
      <label for="wtshare-note"><?= I18N::translate('Mehr Informationen') ?></label>
      <textarea id="wtshare-note" name="note" rows="4"></textarea>
    </div>
  </div>

  <div class="wtshare-card">
    <p class="wtshare-hint" style="margin: 0 0 12px;"><?= I18N::translate('Optional: Wenn wir wissen, wer geantwortet hat, können wir bei Rückfragen leichter noch einmal nachfragen.') ?></p>
    <div class="wtshare-field">
      <label for="wtshare-responder-name"><?= I18N::translate('Dein Name') ?></label>
      <input type="text" id="wtshare-responder-name" name="responder_name">
    </div>
    <div class="wtshare-field">
      <label for="wtshare-responder-email"><?= I18N::translate('Deine E-Mail-Adresse') ?></label>
      <input type="text" id="wtshare-responder-email" name="responder_email">
    </div>
  </div>

  <button type="submit"><?= I18N::translate('Abschicken') ?></button>
</form>
