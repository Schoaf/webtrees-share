<?php

declare(strict_types=1);

use Fisharebest\Webtrees\I18N;

/**
 * @var string $title
 * @var object $row
 * @var string $name
 * @var string $responder
 * @var array<string,array{before: string, after: string}> $compare
 * @var string $note
 * @var bool   $applied
 * @var string $action
 * @var string $photo_url
 * @var string $delete_action
 */

$field_labels = [
    'GIVN'      => I18N::translate('Vorname'),
    'SURN'      => I18N::translate('Nachname'),
    'TITL'      => I18N::translate('Titel'),
    'BIRT_DATE' => I18N::translate('Geburtsdatum'),
    'BIRT_PLAC' => I18N::translate('Geburtsort'),
    'DEAT_DATE' => I18N::translate('Sterbedatum'),
    'DEAT_PLAC' => I18N::translate('Sterbeort'),
];

?>

<style>
  .wtshare-review, .wtshare-review * { box-sizing: border-box; }
  .wtshare-review {
    max-width: 720px;
    margin: 0 auto;
    padding: 0 4px;
    font-family: 'Roboto', system-ui, sans-serif;
  }
  .wtshare-compare-row {
    border: 1px solid #E7E0EC;
    border-radius: 12px;
    padding: 16px;
    margin-bottom: 12px;
    background: #FFFFFF;
    width: 100%;
  }
  .wtshare-compare-row label {
    display: flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
  }
  .wtshare-compare-row .values {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
    margin: 10px 0 0;
  }
  .wtshare-compare-row .values > div {
    min-width: 0;
    overflow-wrap: break-word;
  }
  .wtshare-compare-row .values .before { color: #79747E; font-size: 14px; }
  .wtshare-compare-row .values .after { font-weight: 600; font-size: 15px; }
  .wtshare-compare-row img {
    display: block;
    max-width: 100%;
    max-height: 220px;
    height: auto;
    margin: 0 auto;
    border-radius: 8px;
  }
  .wtshare-review button[type="submit"] {
    width: 100%;
    padding: 14px;
    border-radius: 999px;
    border: none;
    background: #2F6FB0;
    color: #FFFFFF;
    font-size: 15px;
    font-weight: 500;
    cursor: pointer;
  }
  .wtshare-review button[type="submit"]:disabled {
    background: #C4C4C4;
    cursor: not-allowed;
  }
  .wtshare-delete-form button[type="submit"] {
    background: transparent;
    color: #B3261E;
    border: 1px solid #E7E0EC;
  }
</style>

<div class="wtshare-review">
  <h2 class="wt-page-title"><?= e($title) ?></h2>
  <p><?= I18N::translate('Für: %s', '<strong>' . e($name) . '</strong>') ?></p>
  <?php if ($responder !== '') : ?>
    <p style="color: #79747E;"><?= I18N::translate('Von: %s', e($responder)) ?></p>
  <?php endif; ?>

  <form
    method="post"
    action="<?= e($delete_action) ?>"
    class="wtshare-delete-form"
    style="margin-bottom: 16px;"
    id="wtshare-delete-form"
  >
    <?= csrf_field() ?>
    <input type="hidden" name="id" value="<?= e((string) $row->id) ?>">
    <button type="submit" id="wtshare-delete-button" data-default-label="<?= e(I18N::translate('Anfrage verwerfen')) ?>" data-confirm-label="<?= e(I18N::translate('Wirklich verwerfen? Nochmal klicken')) ?>">
      <?= I18N::translate('Anfrage verwerfen') ?>
    </button>
  </form>
  <script>
    // A native confirm() here is unreliable - browsers (Safari in particular) start silently
    // suppressing repeated confirm() dialogs on a page after enough of them have been shown,
    // which quietly drops the click instead of ever submitting the form. A plain two-step
    // button (click once to arm it, click again within a few seconds to actually submit)
    // needs no dialog API at all, so it can't be suppressed the same way.
    (function () {
      var form = document.getElementById('wtshare-delete-form');
      var button = document.getElementById('wtshare-delete-button');
      var confirming = false;
      var resetTimer = null;

      form.addEventListener('submit', function (event) {
        if (confirming) {
          return;
        }
        event.preventDefault();
        confirming = true;
        button.textContent = button.dataset.confirmLabel;
        resetTimer = setTimeout(function () {
          confirming = false;
          button.textContent = button.dataset.defaultLabel;
        }, 4000);
      });
    })();
  </script>

  <?php if ($applied) : ?>
    <p class="alert alert-success"><?= I18N::translate('Diese Antwort wurde bereits übernommen.') ?></p>
  <?php elseif ($compare === [] && $note === '' && $photo_url === '') : ?>
    <p><?= I18N::translate('Es wurden keine Änderungen vorgeschlagen.') ?></p>
  <?php else : ?>
    <form method="post" action="<?= e($action) ?>" id="wtshare-apply-form">
      <?= csrf_field() ?>
      <input type="hidden" name="id" value="<?= e((string) $row->id) ?>">

      <?php foreach ($compare as $key => $value) : ?>
        <div class="wtshare-compare-row">
          <label>
            <input type="checkbox" name="accept[<?= e($key) ?>]" value="1">
            <strong><?= e($field_labels[$key] ?? $key) ?></strong>
          </label>
          <div class="values">
            <div class="before">
              <?= I18N::translate('Bisher') ?>: <?= $value['before'] === '' ? I18N::translate('(leer)') : e($value['before']) ?>
            </div>
            <div class="after">
              <?= I18N::translate('Neu') ?>: <?= e($value['after']) ?>
            </div>
          </div>
        </div>
      <?php endforeach; ?>

      <?php if ($note !== '') : ?>
        <div class="wtshare-compare-row">
          <label>
            <input type="checkbox" name="accept[note]" value="1">
            <strong><?= I18N::translate('Als Notiz übernehmen') ?></strong>
          </label>
          <div class="values">
            <div class="after"><?= nl2br(e($note)) ?></div>
          </div>
        </div>
      <?php endif; ?>

      <?php if ($photo_url !== '') : ?>
        <div class="wtshare-compare-row">
          <label>
            <input type="checkbox" name="accept[photo]" value="1">
            <strong><?= I18N::translate('Foto übernehmen') ?></strong>
          </label>
          <div class="values">
            <div class="after"><img src="<?= e($photo_url) ?>" alt=""></div>
          </div>
        </div>
      <?php endif; ?>

      <p><button type="submit" id="wtshare-apply-button" disabled><?= I18N::translate('Ausgewähltes übernehmen') ?></button></p>
    </form>
    <script>
      (function () {
        var form = document.getElementById('wtshare-apply-form');
        var button = document.getElementById('wtshare-apply-button');
        var checkboxes = form.querySelectorAll('input[type="checkbox"]');

        function update() {
          var anyChecked = false;
          checkboxes.forEach(function (checkbox) {
            if (checkbox.checked) {
              anyChecked = true;
            }
          });
          button.disabled = !anyChecked;
        }

        checkboxes.forEach(function (checkbox) {
          checkbox.addEventListener('change', update);
        });
      })();
    </script>
  <?php endif; ?>
</div>
